{
  "name": "llm-abi",
  "version": "0.5.1",
  "description": "Schema compiler for LLM providers",
  "keywords": [
    "abi",
    "ai-sdk",
    "anthropic",
    "compiler",
    "deepseek",
    "gemini",
    "json-schema",
    "llm",
    "mcp",
    "openai",
    "qwen",
    "schema-compatibility",
    "standard-schema",
    "structured-outputs",
    "tool-calling",
    "typescript",
    "xai"
  ],
  "homepage": "https://llm-abi.pages.dev/",
  "bugs": {
    "url": "https://github.com/jammaru/llm-abi/issues"
  },
  "license": "MIT",
  "author": "jammaru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jammaru/llm-abi.git",
    "directory": "packages/core"
  },
  "bin": {
    "llm-abi": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./local": {
      "import": {
        "types": "./dist/local.d.ts",
        "default": "./dist/local.js"
      },
      "require": {
        "types": "./dist/local.d.cts",
        "default": "./dist/local.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/copy-license.mjs",
    "pack:check": "publint && attw --pack . --profile node16",
    "size": "node ../../scripts/size.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
